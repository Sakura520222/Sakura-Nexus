# Sakura-Nexus bootstrap 配置（仅引导凭据与连接信息）
# 全部业务配置存于 MySQL settings 配置中心（docs/design/01 §6）。
# 文件权限：chmod 600；凭据永不经 WebUI 回显。

# ---- MySQL（连接信息）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sakura
MYSQL_PASSWORD=
MYSQL_DATABASE=sakura_bot
MYSQL_MAX_OPEN_CONNS=5

# ---- Telegram 唯一 Bot（必需；token 同时供 Rich Message HTTP 通道复用，ADR-008）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- 真实账号（P0 转发依赖；未配置时经 login-user 子命令或 WebUI 向导登录）----
USERBOT_PHONE_NUMBER=

# ---- Qdrant（P1 起必需；P0 留空即可）----
QDRANT_URL=
QDRANT_API_KEY=

# ---- WebUI（必需）----
# 裸机默认仅监听本机；Docker 部署经 compose override 改 0.0.0.0（docs/design/06 §1.3）
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080
WEBUI_USERNAME=admin
WEBUI_PASSWORD=

# ---- 可选 ----
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=30

# ---- 媒体临时文件（可选；03 §3.9）----
# 媒体下载临时目录；空 = 系统临时目录下 sakura-nexus/ 子目录
MEDIA_TMP_DIR=
